# Giá trị giữ chỗ cho môi trường dev. Sao chép thành .env rồi điền giá trị thật. KHÔNG đặt secret thật vào file này.

# --- Ứng dụng ---
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- MariaDB ---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=tms
MARIADB_USER=tms
MARIADB_PASSWORD=change-me
MARIADB_PORT=3307
DATABASE_URL=mysql://tms:change-me@localhost:3307/tms

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3) ---
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tms-dev
S3_ACCESS_KEY=change-me-minio
S3_SECRET_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
